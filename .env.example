# Credentialless direct retrieval. The CLI reads exported environment variables;
# it does not automatically load this file.
SCRAPER_RETRIEVAL_BACKEND=direct
SCRAPER_ALLOWED_DOMAINS=example.org
SCRAPER_STATE_DIR=.scraper
SCRAPER_WAIT_SECONDS=180
SCRAPER_RETENTION_DAYS=30
SCRAPER_MAX_RESPONSE_BYTES=5000000
SCRAPER_MAX_SNAPSHOT_BYTES=20000000
SCRAPER_USER_AGENT=EvidenceAIScraper/0.5

# Optional anonymous Chromium rendering: install the browser extra and Chromium.
# Select browser for every page, or auto for direct-first JavaScript fallback.
# SCRAPER_RETRIEVAL_BACKEND=auto
BROWSER_TIMEOUT_SECONDS=45
BROWSER_MAX_REQUESTS=80
BROWSER_MAX_TOTAL_BYTES=10000000
BROWSER_MAX_ATTEMPTS=2
BROWSER_RESOURCE_DOMAINS=
BROWSER_EXECUTABLE_PATH=

# Optional local semantic inference. Install/start a compatible server and model
# separately, replace the model ID, then run the actual schema probe.
SCRAPER_INFERENCE_BACKEND=local
LOCAL_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_MODEL=your-local-model-id
LOCAL_API_KEY=
LOCAL_SOURCE_BOUND_EVIDENCE=false
# Experimental literal quote/locator grammar; mutually exclusive with the above.
LOCAL_SOURCE_QUOTE_EVIDENCE=false
HF_TIMEOUT_SECONDS=300

# Optional hosted adapters: deliberately select brightdata / huggingface.
# Keep credentials in local secret storage or exported environment variables.
BRIGHTDATA_API_KEY=
HF_TOKEN=
HF_PROVIDER=
HF_MODEL=

# Paid calls require actual account prices and a cumulative local spending cap.
# Blank values disable paid work; do not assume an advertised free tier applies.
SCRAPER_MAX_SPEND_USD=
BRIGHTDATA_RECORD_USD=
HF_INPUT_MILLION_USD=
HF_OUTPUT_MILLION_USD=

# A rendering adapter must supply observed redirect metadata. Raw Unlocker is
# disabled in the live pipeline when redirect destinations cannot be verified.
BRIGHTDATA_UNLOCKER_ZONE=
BRIGHTDATA_RENDER_RECORD_USD=

# Optional credentialless self-hosted Firecrawl retrieval. Set the backend to
# firecrawl explicitly and pin the actual service commit (40 hex) or image
# digest (sha256:64 hex). Only a literal loopback high-port endpoint is accepted.
# SCRAPER_RETRIEVAL_BACKEND=firecrawl
FIRECRAWL_BASE_URL=http://127.0.0.1:3002
FIRECRAWL_RUNTIME_ID=
# Opt-in delegates target/subresource egress enforcement to the service. The
# returned engine destination is service-reported, not locally observed/IP-pinned.
FIRECRAWL_TRUST_SERVICE_EGRESS=false
# Legacy values are retained for configuration compatibility; this adapter never
# sends a key, calls Firecrawl Cloud or uses hosted extraction formats.
FIRECRAWL_API_KEY=
FIRECRAWL_RECORD_USD=
